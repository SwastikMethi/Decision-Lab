{
  "name": "decisionlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "test": "vitest run --config frontend/vite.config.ts",
    "test:e2e": "playwright test",
    "types:api": "openapi-typescript docs/openapi.json -o frontend/src/api-schema.d.ts && prettier --write frontend/src/api-schema.d.ts",
    "format:check": "prettier --check 'frontend/src/**/*.{ts,tsx,css}' frontend/vite.config.ts frontend/tsconfig.json playwright.config.ts 'frontend/e2e/*.ts' package.json"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-table": "^8.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.16.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
